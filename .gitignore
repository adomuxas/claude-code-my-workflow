# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds
*.bcf

# Local source material and working folders (large, not shared via git)
.claude/projects/
Dissertation latex files/
OCR/
Papers/
newsources/
master_supporting_docs/estonia_paper_literature/
master_supporting_docs/latvia_paper_literature/
master_supporting_docs/source_papers/
master_supporting_docs/template_papers/
master_supporting_docs/PhD thesis Klimantas 2025 Economic growth in the Baltic states.pdf

# Build transcript
Paper/*/build_last.txt
